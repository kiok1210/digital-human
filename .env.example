# Optional cloud engines. Leave blank to stay fully local (Piper + SadTalker + FFmpeg).
# Copy to `.env` and fill in keys. Never commit real keys.

# Fish Audio TTS — https://fish.audio
FISH_API_KEY=
# Optional persistent voice id from Fish Voice Library / cloning
FISH_REFERENCE_ID=
# s2-pro | s2.1-pro | s2.1-pro-free | s1
FISH_MODEL=s2-pro

# Self-hosted Fish Speech API. Start the official server on port 8080.
FISH_LOCAL_URL=http://127.0.0.1:8080/v1/tts
# Optional; only needed if tools/api_server.py was started with --api-key.
FISH_LOCAL_API_KEY=
# One-click startup: native checkout or WSL checkout. Configure one mode.
FISH_SPEECH_DIR=
FISH_PYTHON=
FISH_CHECKPOINT_DIR=
# cpu | cuda | mps. CPU is the safe default for this Windows installation.
FISH_DEVICE=cpu
FISH_WSL_PATH=
FISH_WSL_DISTRO=
FISH_WSL_CHECKPOINT_DIR=
# Set to 0 for CPU mode. Enable half only for a compatible CUDA GPU.
FISH_USE_HALF=0

# HeyGen talking photo — https://www.heygen.com  (uploads portrait + audio)
HEYGEN_API_KEY=

# Defaults when the UI does not override them
DOUYIN_TTS_ENGINE=kokoro
# Kokoro requires sherpa-onnx and soundfile in the studio Python environment.
# Extract the official kokoro-int8-multi-lang-v1_1.tar.bz2 under models/kokoro/.
# DOUYIN_TTS_ENGINE=fish_local
DOUYIN_AVATAR_ENGINE=sadtalker
DOUYIN_POST_ENGINE=ffmpeg
# auto | cpu | gpu. Auto only enables a backend after its self-test passes.
DOUYIN_ACCELERATION=auto
# Set to hyperframes to prefer HyperFrames packaging when Node/npx is available
# DOUYIN_POST_ENGINE=hyperframes
